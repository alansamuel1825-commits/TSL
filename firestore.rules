rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function userExists(userId) {
      return exists(
        /databases/$(database)/documents/users/$(userId)
      );
    }

    function userDoc(userId) {
      return get(
        /databases/$(database)/documents/users/$(userId)
      );
    }

    function userAfterDoc(userId) {
      return getAfter(
        /databases/$(database)/documents/users/$(userId)
      );
    }

    function isStudentAfter(userId) {
      return userAfterDoc(userId).data.role == 'student'
        && userAfterDoc(userId).data.status == 'active';
    }

    function isAlumniAfter(userId) {
      return userAfterDoc(userId).data.role == 'alumni'
        && userAfterDoc(userId).data.status == 'pending';
    }

    function publicAfterMatchesUserIdentity(userId) {
      let publicAfter = getAfter(
        /databases/$(database)/documents/publicProfiles/$(userId)
      );

      let userAfter = userAfterDoc(userId);

      return publicAfter.data.uid == userId
        && publicAfter.data.displayName == userAfter.data.displayName
        && publicAfter.data.role == userAfter.data.role
        && publicAfter.data.photoURL == userAfter.data.photoURL;
    }

    function hasCurrentUser() {
      return emailVerified()
        && userExists(request.auth.uid);
    }

    function isAdmin() {
      return hasCurrentUser()
        && userDoc(request.auth.uid).data.isAdmin == true;
    }

    function isActiveUser() {
      return hasCurrentUser()
        && userDoc(request.auth.uid).data.status == 'active';
    }

    function isStudent() {
      return isActiveUser()
        && userDoc(request.auth.uid).data.role == 'student';
    }

    function isAlumni() {
      return hasCurrentUser()
        && userDoc(request.auth.uid).data.role == 'alumni';
    }

    function validRequiredString(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function validOptionalString(value, maxLength) {
      return value is string
        && value.size() <= maxLength;
    }

    function validPhotoURL(value) {
      return value == null
        || (
          value is string
          && value.size() <= 2048
        );
    }


    function validOptionalHttpsURL(value) {
      return value is string
        && value.size() <= 2048
        && (
          value.size() == 0
          || value.matches('https://.*')
        );
    }


    function validRequiredHttpsURL(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 2048
        && value.matches('https://.*');
    }

    function validOptionalTimestamp(value) {
      return value == null
        || value is timestamp;
    }

    function validCommunityContent(data) {
      return data.kind in [
          'resource',
          'opportunity',
          'event'
        ]

        && validRequiredString(
          data.title,
          140
        )

        && validRequiredString(
          data.summary,
          350
        )

        && validOptionalString(
          data.details,
          4000
        )

        && validOptionalString(
          data.category,
          80
        )

        && validOptionalString(
          data.organization,
          120
        )

        && validOptionalString(
          data.location,
          160
        )

        && validOptionalString(
          data.eligibility,
          700
        )

        && data.eventMode in [
          '',
          'in_person',
          'online',
          'hybrid'
        ]

        && validOptionalTimestamp(
          data.startAt
        )

        && validOptionalTimestamp(
          data.endAt
        )

        && validOptionalTimestamp(
          data.deadline
        )

        && validOptionalHttpsURL(
          data.url
        )

        && data.status in [
          'draft',
          'published'
        ]

        && (
          (
            data.kind == 'resource'
            && validRequiredHttpsURL(
              data.url
            )
            && data.eventMode == ''
            && data.startAt == null
            && data.endAt == null
            && data.deadline == null
            && data.eligibility == ''
          )
          ||
          (
            data.kind == 'opportunity'
            && validRequiredHttpsURL(
              data.url
            )
            && data.eventMode == ''
            && data.startAt == null
            && data.endAt == null
          )
          ||
          (
            data.kind == 'event'
            && data.startAt is timestamp
            && data.deadline == null
            && data.eligibility == ''
            && (
              data.endAt == null
              || data.endAt >= data.startAt
            )
          )
        );
    }

    function validProjectData(data) {
      return validRequiredString(
          data.title,
          120
        )

        && data.category in [
          'Engineering',
          'Software',
          'AI & Data',
          'Science & Research',
          'Design',
          'Entrepreneurship',
          'Social Impact',
          'Other'
        ]

        && validOptionalString(
          data.summary,
          300
        )

        && validOptionalString(
          data.description,
          5000
        )

        && validOptionalString(
          data.role,
          120
        )

        && validOptionalString(
          data.outcome,
          600
        )

        && data.technologies is list
        && data.technologies.size() <= 20

        && validOptionalHttpsURL(
          data.projectUrl
        )

        && validOptionalHttpsURL(
          data.repositoryUrl
        )

        && data.collaborationWanted is bool
        && data.mentorshipWanted is bool

        && data.status in [
          'draft',
          'published'
        ]

        && (
          data.status == 'draft'
          ||
          (
            validRequiredString(
              data.summary,
              300
            )
            && validRequiredString(
              data.description,
              5000
            )
          )
        );
    }

    function alumniProfileExists(userId) {
      return exists(
        /databases/$(database)/documents/alumniProfiles/$(userId)
      );
    }

    function isStudentId(userId) {
      return userExists(userId)
        && userDoc(userId).data.role == 'student'
        && userDoc(userId).data.status == 'active';
    }

    function isVerifiedAlumni() {
      return isAlumni()
        && isActiveUser()
        && alumniProfileExists(request.auth.uid)
        && get(
          /databases/$(database)/documents/alumniProfiles/$(request.auth.uid)
        ).data.verificationStatus == 'verified';
    }

    function isVerifiedAlumniId(userId) {
      return userExists(userId)
        && userDoc(userId).data.role == 'alumni'
        && userDoc(userId).data.status == 'active'
        && alumniProfileExists(userId)
        && get(
          /databases/$(database)/documents/alumniProfiles/$(userId)
        ).data.verificationStatus == 'verified';
    }

    function alumniAcceptsMentorship(userId) {
      return isVerifiedAlumniId(userId)
        && get(
          /databases/$(database)/documents/alumniProfiles/$(userId)
        ).data.mentorshipAvailable == true;
    }

    function conversationExists(conversationId) {
      return exists(
        /databases/$(database)/documents/conversations/$(conversationId)
      );
    }

    function conversationDoc(conversationId) {
      return get(
        /databases/$(database)/documents/conversations/$(conversationId)
      );
    }

    function isConversationParticipant(conversationId) {
      return emailVerified()
        && conversationExists(conversationId)
        && (
          conversationDoc(conversationId).data.studentId == request.auth.uid
          ||
          conversationDoc(conversationId).data.alumniId == request.auth.uid
        );
    }

    function blockedEitherWay(userA, userB) {
      return exists(
        /databases/$(database)/documents/blocks/$(userA)/blockedUsers/$(userB)
      )
      ||
      exists(
        /databases/$(database)/documents/blocks/$(userB)/blockedUsers/$(userA)
      );
    }

    function requestAfterMatchesConversation(
      requestId,
      studentId,
      alumniId
    ) {
      let requestAfter = getAfter(
        /databases/$(database)/documents/mentorshipRequests/$(requestId)
      );

      return requestAfter.data.status == 'accepted'
        && requestAfter.data.studentId == studentId
        && requestAfter.data.alumniId == alumniId;
    }

    function conversationAfterMatchesRequest(
      requestId,
      studentId,
      alumniId
    ) {
      let conversationAfter = getAfter(
        /databases/$(database)/documents/conversations/$(requestId)
      );

      return conversationAfter.data.studentId == studentId
        && conversationAfter.data.alumniId == alumniId
        && conversationAfter.data.mentorshipRequestId == requestId;
    }

    function userAfterMatchesAlumniVerification(
      userId,
      verificationStatus
    ) {
      let userAfter = getAfter(
        /databases/$(database)/documents/users/$(userId)
      );

      return userAfter.data.role == 'alumni'
        && (
          (
            verificationStatus == 'verified'
            && userAfter.data.status == 'active'
          )
          ||
          (
            verificationStatus in ['pending', 'rejected']
            && userAfter.data.status == 'pending'
          )
        );
    }

    function alumniAfterMatchesUserStatus(
      userId,
      accountStatus
    ) {
      let alumniAfter = getAfter(
        /databases/$(database)/documents/alumniProfiles/$(userId)
      );

      return (
        accountStatus == 'active'
        && alumniAfter.data.verificationStatus == 'verified'
      )
      ||
      (
        accountStatus == 'pending'
        && alumniAfter.data.verificationStatus in ['pending', 'rejected']
      );
    }


    // =========================================================
    // USERS (PRIVATE ACCOUNT DATA)
    // =========================================================

    match /users/{userId} {

      /*
       * Private account documents contain email/status/admin data.
       * Only the owner and school-approved admins may read them.
       */
      allow read: if hasCurrentUser()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      /*
       * Account creation must atomically create the matching
       * publicProfiles document.
       */
      allow create: if emailVerified()
        && request.auth.uid == userId

        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'status',
          'photoURL',
          'isAdmin',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'role',
          'status',
          'photoURL',
          'isAdmin',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.uid == request.auth.uid

        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email

        && validRequiredString(
          request.resource.data.displayName,
          100
        )

        && validPhotoURL(
          request.resource.data.photoURL
        )

        && request.resource.data.isAdmin == false

        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time

        && (
          (
            request.resource.data.role == 'student'
            && request.resource.data.status == 'active'
          )
          ||
          (
            request.resource.data.role == 'alumni'
            && request.resource.data.status == 'pending'
          )
        )

        && publicAfterMatchesUserIdentity(userId);

      /*
       * Ordinary identity edits must atomically keep publicProfiles
       * synchronized. Role/status/admin/email remain protected.
       */
      allow update: if hasCurrentUser()
        && request.auth.uid == userId

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'photoURL',
            'updatedAt'
          ])

        && validRequiredString(
          request.resource.data.displayName,
          100
        )

        && validPhotoURL(
          request.resource.data.photoURL
        )

        && request.resource.data.updatedAt == request.time

        && publicAfterMatchesUserIdentity(userId);

      /*
       * Admin account-status changes are restricted to alumni and
       * must stay synchronized with alumni verification.
       * isAdmin itself can never be granted through client rules.
       */
      allow update: if isAdmin()

        && resource.data.role == 'alumni'

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt'
          ])

        && request.resource.data.status
          in ['active', 'pending']

        && request.resource.data.updatedAt == request.time

        && alumniAfterMatchesUserStatus(
          userId,
          request.resource.data.status
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // PUBLIC DISPLAY PROFILES
    // =========================================================

    match /publicProfiles/{userId} {

      /*
       * Safe cross-user identity: no email, admin flag or status.
       * Any verified-email platform member may read it.
       */
      allow read: if hasCurrentUser();

      allow create: if emailVerified()
        && request.auth.uid == userId

        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'role',
          'photoURL',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasAll([
          'uid',
          'displayName',
          'role',
          'photoURL',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.uid == userId

        && validRequiredString(
          request.resource.data.displayName,
          100
        )

        && request.resource.data.role
          in ['student', 'alumni']

        && validPhotoURL(
          request.resource.data.photoURL
        )

        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time

        && publicAfterMatchesUserIdentity(userId);

      /*
       * Owners may update only public display identity, and it
       * must match the private /users document after the batch.
       */
      allow update: if hasCurrentUser()
        && request.auth.uid == userId

        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'photoURL',
            'updatedAt'
          ])

        && validRequiredString(
          request.resource.data.displayName,
          100
        )

        && validPhotoURL(
          request.resource.data.photoURL
        )

        && request.resource.data.updatedAt == request.time

        && publicAfterMatchesUserIdentity(userId);

      /*
       * Admin-only compatibility path for one-time legacy backfill.
       * Data must exactly match the existing private user identity.
       */
      allow create: if isAdmin()
        && userExists(userId)

        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'role',
          'photoURL',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.uid == userId

        && request.resource.data.displayName
          == userDoc(userId).data.displayName

        && request.resource.data.role
          == userDoc(userId).data.role

        && request.resource.data.photoURL
          == userDoc(userId).data.photoURL

        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && userExists(userId)

        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'photoURL',
            'updatedAt'
          ])

        && request.resource.data.displayName
          == userDoc(userId).data.displayName

        && request.resource.data.photoURL
          == userDoc(userId).data.photoURL

        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }


    // =========================================================
    // STUDENT PROFILES
    // =========================================================

    match /studentProfiles/{userId} {

      allow read: if emailVerified()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create: if emailVerified()
        && request.auth.uid == userId
        && isStudentAfter(userId)

        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'graduationYear',
          'interests',
          'bio',
          'profileCompleted',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasAll([
          'uid',
          'name',
          'graduationYear',
          'interests',
          'bio',
          'profileCompleted',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.uid == request.auth.uid

        && validRequiredString(
          request.resource.data.name,
          100
        )

        && validRequiredString(
          request.resource.data.graduationYear,
          20
        )

        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 20

        && validOptionalString(
          request.resource.data.bio,
          2000
        )

        && request.resource.data.profileCompleted == true

        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isStudent()
        && request.auth.uid == userId

        && request.resource.data.uid == resource.data.uid
        && request.resource.data.profileCompleted
          == resource.data.profileCompleted

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'graduationYear',
            'interests',
            'bio',
            'updatedAt'
          ])

        && validRequiredString(
          request.resource.data.name,
          100
        )

        && validRequiredString(
          request.resource.data.graduationYear,
          20
        )

        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 20

        && validOptionalString(
          request.resource.data.bio,
          2000
        )

        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }


    // =========================================================
    // ALUMNI PROFILES
    // =========================================================

    match /alumniProfiles/{userId} {

      /*
       * Verified profiles are visible to active community members.
       * Pending/rejected profiles remain owner/admin-only.
       */
      allow read: if emailVerified()
        && (
          (
            resource.data.verificationStatus == 'verified'
            && hasCurrentUser()
          )
          || request.auth.uid == userId
          || isAdmin()
        );

      allow create: if emailVerified()
        && request.auth.uid == userId
        && isAlumniAfter(userId)

        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'graduationYear',
          'university',
          'degree',
          'field',
          'currentRole',
          'company',
          'expertise',
          'bio',
          'mentorshipAvailable',
          'verificationStatus',
          'profileCompleted',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasAll([
          'uid',
          'name',
          'graduationYear',
          'university',
          'degree',
          'field',
          'currentRole',
          'company',
          'expertise',
          'bio',
          'mentorshipAvailable',
          'verificationStatus',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.uid == request.auth.uid

        && validRequiredString(
          request.resource.data.name,
          100
        )

        && validRequiredString(
          request.resource.data.graduationYear,
          20
        )

        && validOptionalString(
          request.resource.data.university,
          150
        )

        && validOptionalString(
          request.resource.data.degree,
          150
        )

        && validOptionalString(
          request.resource.data.field,
          150
        )

        && validOptionalString(
          request.resource.data.currentRole,
          150
        )

        && validOptionalString(
          request.resource.data.company,
          150
        )

        && request.resource.data.expertise is list
        && request.resource.data.expertise.size() <= 20

        && validOptionalString(
          request.resource.data.bio,
          3000
        )

        && request.resource.data.mentorshipAvailable is bool

        && request.resource.data.verificationStatus == 'pending'

        && (
          !('profileCompleted' in request.resource.data)
          || request.resource.data.profileCompleted == true
        )

        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      /*
       * Alumni can edit profile information but never their own
       * verification status or UID.
       */
      allow update: if isAlumni()
        && request.auth.uid == userId

        && request.resource.data.uid == resource.data.uid

        && request.resource.data.verificationStatus
          == resource.data.verificationStatus

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'graduationYear',
            'university',
            'degree',
            'field',
            'currentRole',
            'company',
            'expertise',
            'bio',
            'mentorshipAvailable',
            'updatedAt'
          ])

        && validRequiredString(
          request.resource.data.name,
          100
        )

        && validRequiredString(
          request.resource.data.graduationYear,
          20
        )

        && validOptionalString(
          request.resource.data.university,
          150
        )

        && validOptionalString(
          request.resource.data.degree,
          150
        )

        && validOptionalString(
          request.resource.data.field,
          150
        )

        && validOptionalString(
          request.resource.data.currentRole,
          150
        )

        && validOptionalString(
          request.resource.data.company,
          150
        )

        && request.resource.data.expertise is list
        && request.resource.data.expertise.size() <= 20

        && validOptionalString(
          request.resource.data.bio,
          3000
        )

        && request.resource.data.mentorshipAvailable is bool

        && request.resource.data.updatedAt == request.time;

      /*
       * Verification is admin-only and synchronized with users.status.
       */
      allow update: if isAdmin()

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'verificationStatus',
            'updatedAt'
          ])

        && request.resource.data.verificationStatus
          in [
            'pending',
            'verified',
            'rejected'
          ]

        && request.resource.data.updatedAt == request.time

        && userAfterMatchesAlumniVerification(
          userId,
          request.resource.data.verificationStatus
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // MENTORSHIP REQUESTS
    // =========================================================

    match /mentorshipRequests/{requestId} {

      allow create: if isStudent()

        && request.resource.data.keys().hasOnly([
          'studentId',
          'alumniId',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasAll([
          'studentId',
          'alumniId',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.studentId == request.auth.uid

        && request.resource.data.alumniId is string

        && request.resource.data.alumniId != request.auth.uid

        && alumniAcceptsMentorship(
          request.resource.data.alumniId
        )

        && validRequiredString(
          request.resource.data.message,
          2000
        )

        && request.resource.data.status == 'pending'

        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if hasCurrentUser()
        && (
          resource.data.studentId == request.auth.uid
          || resource.data.alumniId == request.auth.uid
          || isAdmin()
        );

      /*
       * ACCEPT: acceptance must atomically create the matching
       * deterministic conversation.
       */
      allow update: if isVerifiedAlumni()

        && resource.data.alumniId == request.auth.uid

        && resource.data.status == 'pending'

        && request.resource.data.status == 'accepted'

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt'
          ])

        && request.resource.data.updatedAt == request.time

        && conversationAfterMatchesRequest(
          requestId,
          resource.data.studentId,
          resource.data.alumniId
        );

      /*
       * DECLINE
       */
      allow update: if isVerifiedAlumni()

        && resource.data.alumniId == request.auth.uid

        && resource.data.status == 'pending'

        && request.resource.data.status == 'declined'

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt'
          ])

        && request.resource.data.updatedAt == request.time;

      /*
       * CANCEL
       */
      allow update: if isStudent()

        && resource.data.studentId == request.auth.uid

        && resource.data.status == 'pending'

        && request.resource.data.status == 'cancelled'

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt'
          ])

        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }


    // =========================================================
    // CONVERSATIONS
    // =========================================================

    match /conversations/{conversationId} {

      allow read: if emailVerified()
        && (
          resource.data.studentId == request.auth.uid
          || resource.data.alumniId == request.auth.uid
          || isAdmin()
        );

      /*
       * A conversation may only be created by the verified alumnus
       * in the same atomic operation that accepts the request.
       */
      allow create: if isVerifiedAlumni()

        && request.resource.data.keys().hasOnly([
          'studentId',
          'alumniId',
          'mentorshipRequestId',
          'createdAt',
          'lastMessage',
          'lastMessageAt'
        ])

        && request.resource.data.keys().hasAll([
          'studentId',
          'alumniId',
          'mentorshipRequestId',
          'createdAt',
          'lastMessage',
          'lastMessageAt'
        ])

        && request.resource.data.studentId is string
        && request.resource.data.alumniId is string
        && request.resource.data.mentorshipRequestId is string

        && request.resource.data.alumniId == request.auth.uid

        && request.resource.data.studentId
          != request.resource.data.alumniId

        && isStudentId(
          request.resource.data.studentId
        )

        && conversationId
          == request.resource.data.mentorshipRequestId

        && requestAfterMatchesConversation(
          conversationId,
          request.resource.data.studentId,
          request.resource.data.alumniId
        )

        && !blockedEitherWay(
          request.resource.data.studentId,
          request.resource.data.alumniId
        )

        && request.resource.data.lastMessage == ''

        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time;

      /*
       * Participants may only update chat preview metadata.
       * Participant IDs and mentorshipRequestId remain immutable.
       */
      allow update: if isActiveUser()

        && (
          resource.data.studentId == request.auth.uid
          || resource.data.alumniId == request.auth.uid
        )

        && !blockedEitherWay(
          resource.data.studentId,
          resource.data.alumniId
        )

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'lastMessage',
            'lastMessageAt'
          ])

        && validRequiredString(
          request.resource.data.lastMessage,
          2000
        )

        && request.resource.data.lastMessageAt == request.time;

      allow delete: if isAdmin();


      // =======================================================
      // MESSAGES
      // =======================================================

      match /messages/{messageId} {

        /*
         * Blocking does not erase existing message history.
         */
        allow read: if emailVerified()
          && (
            isConversationParticipant(conversationId)
            || isAdmin()
          );

        allow create: if isActiveUser()

          && isConversationParticipant(conversationId)

          && !blockedEitherWay(
            conversationDoc(conversationId).data.studentId,
            conversationDoc(conversationId).data.alumniId
          )

          && request.resource.data.keys().hasOnly([
            'senderId',
            'text',
            'createdAt'
          ])

          && request.resource.data.keys().hasAll([
            'senderId',
            'text',
            'createdAt'
          ])

          && request.resource.data.senderId == request.auth.uid

          && validRequiredString(
            request.resource.data.text,
            2000
          )

          && request.resource.data.createdAt == request.time;

        /*
         * Ordinary users cannot rewrite message history.
         * Admins may remove a message for moderation, but even
         * admins cannot alter the text of a sent message.
         */
        allow update: if false;
        allow delete: if isAdmin();
      }
    }


    // =========================================================
    // ASK AN ALUMNI
    // =========================================================

    match /questions/{questionId} {

      allow read: if
        isStudent()
        || isVerifiedAlumni()
        || isAdmin();

      allow create: if isStudent()

        && request.resource.data.keys().hasOnly([
          'studentId',
          'studentName',
          'questionText',
          'status',
          'createdAt'
        ])

        && request.resource.data.keys().hasAll([
          'studentId',
          'studentName',
          'questionText',
          'status',
          'createdAt'
        ])

        && request.resource.data.studentId == request.auth.uid

        && request.resource.data.studentName
          == userDoc(request.auth.uid).data.displayName

        && validRequiredString(
          request.resource.data.questionText,
          3000
        )

        && request.resource.data.status == 'open'

        && request.resource.data.createdAt == request.time;

      /*
       * Only a verified alumnus may answer, and the displayed
       * answerer name must match their account identity.
       */
      allow update: if isVerifiedAlumni()

        && resource.data.status == 'open'

        && request.resource.data.status == 'answered'

        && request.resource.data.answererId == request.auth.uid

        && request.resource.data.answererName
          == userDoc(request.auth.uid).data.displayName

        && validRequiredString(
          request.resource.data.answerText,
          5000
        )

        && request.resource.data.answeredAt == request.time

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'answererId',
            'answererName',
            'answerText',
            'answeredAt'
          ]);

      allow delete: if isAdmin();
    }


    // =========================================================
    // REPORTS
    // =========================================================

    match /reports/{reportId} {

      /*
       * Reporting remains available to a verified-email account
       * that participates in the conversation, even if that
       * account later stops being active.
       */
      allow create: if hasCurrentUser()

        && request.resource.data.keys().hasOnly([
          'conversationId',
          'reporterId',
          'reporterName',
          'reportedUserId',
          'reportedUserName',
          'reason',
          'status',
          'createdAt'
        ])

        && request.resource.data.keys().hasAll([
          'conversationId',
          'reporterId',
          'reporterName',
          'reportedUserId',
          'reportedUserName',
          'reason',
          'status',
          'createdAt'
        ])

        && request.resource.data.reporterId == request.auth.uid

        && request.resource.data.reporterName
          == userDoc(request.auth.uid).data.displayName

        && request.resource.data.conversationId is string

        && conversationExists(
          request.resource.data.conversationId
        )

        && isConversationParticipant(
          request.resource.data.conversationId
        )

        && request.resource.data.reportedUserId is string

        && request.resource.data.reportedUserId
          != request.auth.uid

        && (
          request.resource.data.reportedUserId
            == conversationDoc(
              request.resource.data.conversationId
            ).data.studentId

          ||

          request.resource.data.reportedUserId
            == conversationDoc(
              request.resource.data.conversationId
            ).data.alumniId
        )

        && request.resource.data.reportedUserName
          == userDoc(
            request.resource.data.reportedUserId
          ).data.displayName

        && validRequiredString(
          request.resource.data.reason,
          2000
        )

        && request.resource.data.status == 'open'

        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin();

      /*
       * Reports can move one way: open -> resolved.
       */
      allow update: if isAdmin()

        && resource.data.status == 'open'

        && request.resource.data.status == 'resolved'

        && request.resource.data.resolvedAt == request.time

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'resolvedAt'
          ]);

      allow delete: if isAdmin();
    }


    // =========================================================
    // BLOCKING
    // =========================================================

    match /blocks/{blockerId}/blockedUsers/{blockedId} {

      allow create: if hasCurrentUser()

        && request.auth.uid == blockerId

        && blockerId != blockedId

        && userExists(blockedId)

        && request.resource.data.keys().hasOnly([
          'blockerId',
          'blockedId',
          'createdAt'
        ])

        && request.resource.data.keys().hasAll([
          'blockerId',
          'blockedId',
          'createdAt'
        ])

        && request.resource.data.blockerId == blockerId

        && request.resource.data.blockedId == blockedId

        && request.resource.data.createdAt == request.time;

      allow read: if hasCurrentUser()
        && (
          request.auth.uid == blockerId
          || request.auth.uid == blockedId
          || isAdmin()
        );

      allow delete: if hasCurrentUser()
        && (
          request.auth.uid == blockerId
          || isAdmin()
        );

      allow update: if false;
    }






    // =========================================================
    // COMMUNITY HUB
    // Resources, opportunities and events
    // =========================================================

    match /communityContent/{contentId} {

      /*
       * Published content is available to active TSL community
       * members. Drafts remain school-admin only.
       */
      allow read: if hasCurrentUser()
        && (
          isAdmin()
          ||
          (
            resource.data.status
              == 'published'
            && isActiveUser()
          )
        );

      /*
       * Curated hub content is school-controlled.
       * Ordinary members cannot publish links/events/opportunities.
       */
      allow create: if isAdmin()

        && request.resource.data.keys().hasOnly([
          'kind',
          'title',
          'summary',
          'details',
          'category',
          'organization',
          'location',
          'eventMode',
          'startAt',
          'endAt',
          'deadline',
          'eligibility',
          'url',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasAll([
          'kind',
          'title',
          'summary',
          'details',
          'category',
          'organization',
          'location',
          'eventMode',
          'startAt',
          'endAt',
          'deadline',
          'eligibility',
          'url',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.createdBy
          == request.auth.uid

        && validCommunityContent(
          request.resource.data
        )

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      allow update: if isAdmin()

        && request.resource.data.createdBy
          == resource.data.createdBy

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'kind',
            'title',
            'summary',
            'details',
            'category',
            'organization',
            'location',
            'eventMode',
            'startAt',
            'endAt',
            'deadline',
            'eligibility',
            'url',
            'status',
            'updatedAt'
          ])

        && validCommunityContent(
          request.resource.data
        )

        && request.resource.data.updatedAt
          == request.time;

      allow delete: if isAdmin();
    }


    // =========================================================
    // SAVED HUB CONTENT (PRIVATE)
    // =========================================================

    match /savedContent/{userId}/items/{contentId} {

      allow read: if hasCurrentUser()
        && request.auth.uid
          == userId;

      allow create: if isActiveUser()
        && request.auth.uid
          == userId

        && request.resource.data.keys().hasOnly([
          'uid',
          'contentId',
          'createdAt'
        ])

        && request.resource.data.keys().hasAll([
          'uid',
          'contentId',
          'createdAt'
        ])

        && request.resource.data.uid
          == userId

        && request.resource.data.contentId
          == contentId

        && request.resource.data.createdAt
          == request.time

        && exists(
          /databases/$(database)/documents/communityContent/$(contentId)
        )

        && get(
          /databases/$(database)/documents/communityContent/$(contentId)
        ).data.status
          == 'published';

      allow update: if false;

      allow delete: if hasCurrentUser()
        && request.auth.uid
          == userId;
    }


    // =========================================================
    // PROJECTS / PORTFOLIO
    // =========================================================

    match /projects/{projectId} {

      /*
       * Drafts remain private to the owner and school admins.
       * Published projects are visible only to active,
       * verified-email TSL community members.
       */
      allow read: if hasCurrentUser()
        && (
          request.auth.uid == resource.data.ownerId
          || isAdmin()
          ||
          (
            resource.data.status == 'published'
            && isActiveUser()
          )
        );

      /*
       * Only active community members may create projects.
       * Pending alumni therefore cannot publish or create a
       * portfolio until school verification is complete.
       */
      allow create: if isActiveUser()

        && request.resource.data.keys().hasOnly([
          'ownerId',
          'title',
          'category',
          'summary',
          'description',
          'role',
          'outcome',
          'technologies',
          'projectUrl',
          'repositoryUrl',
          'collaborationWanted',
          'mentorshipWanted',
          'status',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasAll([
          'ownerId',
          'title',
          'category',
          'summary',
          'description',
          'role',
          'outcome',
          'technologies',
          'projectUrl',
          'repositoryUrl',
          'collaborationWanted',
          'mentorshipWanted',
          'status',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.ownerId
          == request.auth.uid

        && validProjectData(
          request.resource.data
        )

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      /*
       * Owners may edit content and change draft/published state.
       * Ownership and creation timestamp are immutable.
       */
      allow update: if isActiveUser()

        && resource.data.ownerId
          == request.auth.uid

        && request.resource.data.ownerId
          == resource.data.ownerId

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'title',
            'category',
            'summary',
            'description',
            'role',
            'outcome',
            'technologies',
            'projectUrl',
            'repositoryUrl',
            'collaborationWanted',
            'mentorshipWanted',
            'status',
            'updatedAt'
          ])

        && validProjectData(
          request.resource.data
        )

        && request.resource.data.updatedAt
          == request.time;

      /*
       * Owners retain the ability to delete their own project
       * even if their account later stops being active.
       * School admins may also remove a project for moderation.
       */
      allow delete: if hasCurrentUser()
        && (
          resource.data.ownerId
            == request.auth.uid
          || isAdmin()
        );
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{recipientId}/items/{notificationId} {

      allow read: if hasCurrentUser()
        && request.auth.uid == recipientId;

      allow create: if hasCurrentUser()

        && request.resource.data.keys().hasOnly([
          'recipientId',
          'actorId',
          'type',
          'entityId',
          'eventId',
          'createdAt',
          'readAt'
        ])

        && request.resource.data.keys().hasAll([
          'recipientId',
          'actorId',
          'type',
          'entityId',
          'eventId',
          'createdAt',
          'readAt'
        ])

        && request.resource.data.recipientId
          == recipientId

        && request.resource.data.actorId
          is string

        && request.resource.data.entityId
          is string

        && request.resource.data.eventId
          is string

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.readAt
          == null

        && (

          (
            request.resource.data.type
              == 'mentorship_requested'

            && request.resource.data.actorId
              == request.auth.uid

            && request.resource.data.entityId
              == request.resource.data.eventId

            && notificationId
              == 'mentorship-requested-'
                + request.resource.data.eventId

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.studentId
              == request.auth.uid

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.alumniId
              == recipientId

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.status
              == 'pending'
          )

          ||

          (
            request.resource.data.type
              == 'mentorship_accepted'

            && request.resource.data.actorId
              == request.auth.uid

            && request.resource.data.entityId
              == request.resource.data.eventId

            && notificationId
              == 'mentorship-accepted-'
                + request.resource.data.eventId

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.alumniId
              == request.auth.uid

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.studentId
              == recipientId

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.status
              == 'accepted'
          )

          ||

          (
            request.resource.data.type
              == 'mentorship_declined'

            && request.resource.data.actorId
              == request.auth.uid

            && request.resource.data.entityId
              == request.resource.data.eventId

            && notificationId
              == 'mentorship-declined-'
                + request.resource.data.eventId

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.alumniId
              == request.auth.uid

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.studentId
              == recipientId

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.status
              == 'declined'
          )

          ||

          (
            request.resource.data.type
              == 'mentorship_cancelled'

            && request.resource.data.actorId
              == request.auth.uid

            && request.resource.data.entityId
              == request.resource.data.eventId

            && notificationId
              == 'mentorship-cancelled-'
                + request.resource.data.eventId

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.studentId
              == request.auth.uid

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.alumniId
              == recipientId

            && getAfter(
              /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.entityId)
            ).data.status
              == 'cancelled'
          )

          ||

          (
            request.resource.data.type
              == 'new_message'

            && request.resource.data.actorId
              == request.auth.uid

            && notificationId
              == 'message-'
                + request.resource.data.eventId

            && getAfter(
              /databases/$(database)/documents/conversations/$(request.resource.data.entityId)/messages/$(request.resource.data.eventId)
            ).data.senderId
              == request.auth.uid

            && (
              (
                conversationDoc(
                  request.resource.data.entityId
                ).data.studentId
                  == request.auth.uid

                && conversationDoc(
                  request.resource.data.entityId
                ).data.alumniId
                  == recipientId
              )
              ||
              (
                conversationDoc(
                  request.resource.data.entityId
                ).data.alumniId
                  == request.auth.uid

                && conversationDoc(
                  request.resource.data.entityId
                ).data.studentId
                  == recipientId
              )
            )
          )

          ||

          (
            request.resource.data.type
              == 'question_answered'

            && request.resource.data.actorId
              == request.auth.uid

            && request.resource.data.entityId
              == request.resource.data.eventId

            && notificationId
              == 'question-answered-'
                + request.resource.data.eventId

            && getAfter(
              /databases/$(database)/documents/questions/$(request.resource.data.entityId)
            ).data.answererId
              == request.auth.uid

            && getAfter(
              /databases/$(database)/documents/questions/$(request.resource.data.entityId)
            ).data.studentId
              == recipientId

            && getAfter(
              /databases/$(database)/documents/questions/$(request.resource.data.entityId)
            ).data.status
              == 'answered'
          )

          ||

          (
            isActiveUser()

            && recipientId
              == request.auth.uid

            && request.resource.data.type
              == 'hub_reminder'

            && request.resource.data.actorId
              == request.auth.uid

            && request.resource.data.entityId
              == request.resource.data.eventId

            && notificationId
              == 'hub-reminder-'
                + request.resource.data.entityId

            && exists(
              /databases/$(database)/documents/contentReminders/$(recipientId)/items/$(request.resource.data.entityId)
            )

            && get(
              /databases/$(database)/documents/contentReminders/$(recipientId)/items/$(request.resource.data.entityId)
            ).data.uid
              == request.auth.uid

            && get(
              /databases/$(database)/documents/contentReminders/$(recipientId)/items/$(request.resource.data.entityId)
            ).data.contentId
              == request.resource.data.entityId

            && get(
              /databases/$(database)/documents/contentReminders/$(recipientId)/items/$(request.resource.data.entityId)
            ).data.deliveredAt
              == null

            && get(
              /databases/$(database)/documents/contentReminders/$(recipientId)/items/$(request.resource.data.entityId)
            ).data.remindAt
              <= request.time
          )

          ||

          (
            isAdmin()

            && request.resource.data.type
              in [
                'alumni_verified',
                'alumni_rejected'
              ]

            && request.resource.data.actorId
              == request.auth.uid

            && request.resource.data.entityId
              == recipientId

            && request.resource.data.eventId
              == recipientId

            && (
              (
                request.resource.data.type
                  == 'alumni_verified'

                && getAfter(
                  /databases/$(database)/documents/alumniProfiles/$(recipientId)
                ).data.verificationStatus
                  == 'verified'
              )
              ||
              (
                request.resource.data.type
                  == 'alumni_rejected'

                && getAfter(
                  /databases/$(database)/documents/alumniProfiles/$(recipientId)
                ).data.verificationStatus
                  == 'rejected'
              )
            )
          )
        );

      allow update: if hasCurrentUser()
        && request.auth.uid == recipientId

        && resource.data.readAt == null

        && request.resource.data.readAt
          == request.time

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'readAt'
          ]);

      allow delete: if hasCurrentUser()
        && request.auth.uid == recipientId;
    }



    // =========================================================
    // NOTIFICATION PREFERENCES (PRIVATE)
    // =========================================================

    match /notificationPreferences/{userId} {

      allow read: if hasCurrentUser()
        && request.auth.uid == userId;

      allow create: if hasCurrentUser()
        && request.auth.uid == userId

        && request.resource.data.keys().hasOnly([
          'uid',
          'mentorshipAlerts',
          'messageAlerts',
          'qnaAlerts',
          'hubReminders',
          'reminderLeadHours',
          'timezone',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasAll([
          'uid',
          'mentorshipAlerts',
          'messageAlerts',
          'qnaAlerts',
          'hubReminders',
          'reminderLeadHours',
          'timezone',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.uid
          == userId

        && request.resource.data.mentorshipAlerts
          is bool

        && request.resource.data.messageAlerts
          is bool

        && request.resource.data.qnaAlerts
          is bool

        && request.resource.data.hubReminders
          is bool

        && request.resource.data.reminderLeadHours
          in [12, 24, 48, 72]

        && request.resource.data.timezone
          is string

        && request.resource.data.timezone.size()
          > 0

        && request.resource.data.timezone.size()
          <= 80

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      allow update: if hasCurrentUser()
        && request.auth.uid == userId

        && request.resource.data.uid
          == resource.data.uid

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'mentorshipAlerts',
            'messageAlerts',
            'qnaAlerts',
            'hubReminders',
            'reminderLeadHours',
            'timezone',
            'updatedAt'
          ])

        && request.resource.data.mentorshipAlerts
          is bool

        && request.resource.data.messageAlerts
          is bool

        && request.resource.data.qnaAlerts
          is bool

        && request.resource.data.hubReminders
          is bool

        && request.resource.data.reminderLeadHours
          in [12, 24, 48, 72]

        && request.resource.data.timezone
          is string

        && request.resource.data.timezone.size()
          > 0

        && request.resource.data.timezone.size()
          <= 80

        && request.resource.data.updatedAt
          == request.time;

      allow delete: if hasCurrentUser()
        && request.auth.uid == userId;
    }


    // =========================================================
    // HUB CONTENT REMINDERS (PRIVATE)
    // =========================================================

    match /contentReminders/{userId}/items/{contentId} {

      allow read: if hasCurrentUser()
        && request.auth.uid == userId;

      allow create: if isActiveUser()
        && request.auth.uid == userId

        && request.resource.data.keys().hasOnly([
          'uid',
          'contentId',
          'kind',
          'remindAt',
          'targetAt',
          'deliveredAt',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasAll([
          'uid',
          'contentId',
          'kind',
          'remindAt',
          'targetAt',
          'deliveredAt',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.uid
          == userId

        && request.resource.data.contentId
          == contentId

        && request.resource.data.kind
          in [
            'event',
            'opportunity'
          ]

        && request.resource.data.remindAt
          is timestamp

        && request.resource.data.targetAt
          is timestamp

        && request.resource.data.remindAt
          <= request.resource.data.targetAt

        && request.resource.data.deliveredAt
          == null

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time

        && exists(
          /databases/$(database)/documents/communityContent/$(contentId)
        )

        && get(
          /databases/$(database)/documents/communityContent/$(contentId)
        ).data.status
          == 'published'

        && get(
          /databases/$(database)/documents/communityContent/$(contentId)
        ).data.kind
          == request.resource.data.kind

        && (
          (
            request.resource.data.kind
              == 'event'

            && get(
              /databases/$(database)/documents/communityContent/$(contentId)
            ).data.startAt
              == request.resource.data.targetAt
          )
          ||
          (
            request.resource.data.kind
              == 'opportunity'

            && get(
              /databases/$(database)/documents/communityContent/$(contentId)
            ).data.deadline
              == request.resource.data.targetAt
          )
        );

      allow update: if hasCurrentUser()
        && request.auth.uid == userId

        && request.resource.data.uid
          == resource.data.uid

        && request.resource.data.contentId
          == resource.data.contentId

        && request.resource.data.kind
          == resource.data.kind

        && request.resource.data.targetAt
          == resource.data.targetAt

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data.remindAt
          is timestamp

        && request.resource.data.remindAt
          <= request.resource.data.targetAt

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'remindAt',
            'deliveredAt',
            'updatedAt'
          ])

        && request.resource.data.updatedAt
          == request.time

        && (
          (
            resource.data.deliveredAt
              == null

            && request.resource.data.deliveredAt
              == null
          )
          ||
          (
            resource.data.deliveredAt
              == null

            && resource.data.remindAt
              <= request.time

            && request.resource.data.remindAt
              == resource.data.remindAt

            && request.resource.data.deliveredAt
              == request.time
          )
        );

      allow delete: if hasCurrentUser()
        && request.auth.uid == userId;
    }


    // =========================================================
    // USER PREFERENCES (PRIVATE)
    // =========================================================

    match /userPreferences/{userId} {

      /*
       * Display/accessibility preferences are private.
       * School admins do not need blanket access to them.
       */
      allow read: if hasCurrentUser()
        && request.auth.uid == userId;

      allow create: if hasCurrentUser()
        && request.auth.uid == userId

        && request.resource.data.keys().hasOnly([
          'uid',
          'theme',
          'textSize',
          'highContrast',
          'reduceMotion',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasAll([
          'uid',
          'theme',
          'textSize',
          'highContrast',
          'reduceMotion',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.uid == userId

        && request.resource.data.theme
          in ['system', 'light', 'dark']

        && request.resource.data.textSize
          in ['default', 'large']

        && request.resource.data.highContrast is bool

        && request.resource.data.reduceMotion is bool

        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if hasCurrentUser()
        && request.auth.uid == userId

        && request.resource.data.uid == resource.data.uid

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'theme',
            'textSize',
            'highContrast',
            'reduceMotion',
            'updatedAt'
          ])

        && request.resource.data.theme
          in ['system', 'light', 'dark']

        && request.resource.data.textSize
          in ['default', 'large']

        && request.resource.data.highContrast is bool

        && request.resource.data.reduceMotion is bool

        && request.resource.data.updatedAt == request.time;

      allow delete: if hasCurrentUser()
        && request.auth.uid == userId;
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
